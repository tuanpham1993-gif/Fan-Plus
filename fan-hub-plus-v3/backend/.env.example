# Generate your own key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///fanhub-demo.db
# MySQL target example:
# DATABASE_URL=mysql+pymysql://fanhub:CHANGE_ME@127.0.0.1:3306/fanhub?charset=utf8mb4
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=0
# Local demonstration only. Set 0 outside a supervised demo; then verify via CLI.
DEMO_VERIFY_REGISTRATION=1
LORE_MODE=extractive
# To call a real model, use LORE_MODE=openai and BOTH settings below.
OPENAI_API_KEY=
OPENAI_MODEL=
# Real prize campaigns are deliberately disabled in application code.

# Development profile only. Do not commit a real .env.
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///instance/fanhub-dev.db
# MySQL target (matches the chosen SRS database family):
# DATABASE_URL=mysql+pymysql://fanhub:your-password@127.0.0.1:3306/fanhub?charset=utf8mb4
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUSTED_HOSTS=localhost,127.0.0.1
RATELIMIT_STORAGE_URI=memory://
# Development mailbox: backend/instance/dev-mailbox. Never published by Flask.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

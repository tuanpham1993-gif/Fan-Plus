FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid appgroup --create-home appuser
COPY --chown=10001:10001 backend/ /app/backend/
COPY --chown=10001:10001 frontend/dist/ /app/frontend/dist/
RUN mkdir -p /app/backend/instance && chown -R appuser:appgroup /app/backend/instance
USER 10001:10001
EXPOSE 5000
CMD ["waitress-serve", "--host", "0.0.0.0", "--port", "5000", "--threads", "4", "wsgi:app"]
